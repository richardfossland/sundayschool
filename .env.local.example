# Copy to .env.local and fill in. Uses the SHARED SundaySuite Supabase project
# (same project as SundayLicks/Plan/Welcome) — SundaySchool lives in its own
# `school` Postgres schema. After running supabase/migrations the `school`
# schema MUST be added under Settings → API → Exposed schemas.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_APP_URL=https://school.sundaysuite.app

# Service-role key. Needed for `npm run seed` (upserts curated songs) only —
# the MVP app itself has no server write paths.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
